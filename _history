ment></block></xml>","main.ts":"","README.md":" ","assets.json":"","main.py":"# 3. Function to draw the 5x6 grid on the screen\ndef draw_board():\n    bg = image.create(160, 120)\n    bg.fill(15) # Black background\n    \n    box_size = 16\n    gap = 2\n    # Center the 5x6 grid on the 160x120 screen\n    start_x = (160 - (5 * box_size + 4 * gap)) // 2\n    start_y = 6\n    \n    for row in range(max_guesses):\n        for col in range(5):\n            x = start_x + col * (box_size + gap)\n            y = start_y + row * (box_size + gap)\n            \n            # If this row has already been guessed\n            if row < len(guesses):\n                guess_word = guesses[row]\n                letter = 'A'\n                \n                # Check color logic (Green -> Yellow -> Grey)\n                box_color = COLOR_GREY\n                if letter == secret[col]:\n                    box_color = COLOR_GREEN\n                elif secret.index_of(letter) != -1:\n                    box_color = COLOR_YELLOW\n                \n                # Draw filled colored tile and white letter\n                bg.fill_rect(x, y, box_size, box_size, box_color)\n                bg.print(letter, x + 5, y + 4, 1)\n            else:\n                # Draw empty outline box for future guesses\n                bg.draw_rect(x, y, box_size, box_size, COLOR_BORDER)\n                \n    scene.set_background_image(bg)\n\nstart_y = 0\nstart_x = 0\ngap = 0\nbox_size = 0\nbg: Image = None\nguesses: List[number] = []\nCOLOR_BORDER = 0\nCOLOR_GREY = 0\nCOLOR_YELLOW = 0\nCOLOR_GREEN = 0\nmax_guesses = 0\nsecret = \"\"\nwords = [\"APPLE\",\n    \"BRAVE\",\n    \"CRANE\",\n    \"DREAM\",\n    \"EAGLE\",\n    \"FLAME\",\n    \"GRAPE\",\n    \"HOUSE\",\n    \"INPUT\",\n    \"JOKER\",\n    \"KNIFE\",\n    \"LEMON\",\n    \"MOUSE\",\n    \"NIGHT\",\n    \"OCEAN\",\n    \"PIANO\",\n    \"QUEEN\",\n    \"ROBOT\",\n    \"SNAKE\",\n    \"TRAIN\",\n    \"UNDER\",\n    \"VOICE\",\n    \"WATER\",\n    \"YOUTH\",\n    \"ZEBRA\"]\n# 2. Pick a random secret word\nsecret = words[randint(0, len(words) - 1)]\nmax_guesses = 6\n# MakeCode Arcade Color Palette IDs:\n# 7 = Green, 5 = Yellow, 11 = Dark Grey, 1 = White, 15 = Black\nCOLOR_GREEN = 7\nCOLOR_YELLOW = 5\nCOLOR_GREY = 11\nCOLOR_BORDER = 13\n# 4. Start the game loop\ndraw_board()\npause(500)\nwhile len(guesses) < max_guesses:\n    # Prompt player using MakeCode's built-in on-screen keyboard\n    raw_input = game.ask_for_string(\"Enter 5-letter word:\", 5)\n    guess = raw_input.to_upper_case()\n    # Validate length\n    if len(guess) != 5:\n        game.splash(\"Must be 5 letters!\")\n        continue","pxt.json":"{\n    \"name\": \"wordle88\",\n    \"description\": \"wordle88, guess a five letter word - you only have six guesses\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\"\n}\n"}}],"shares":[{"id":"11152-67682-08264-07301","type":"permalink","timestamp":1795354658008},{"id":"31028-31804-61244-47269","type":"permalink","timestamp":1795354893825},{"id":"51553-69919-48069-43045","type":"permalink","timestamp":1795354946302},{"id":"14078-59663-24184-27419","type":"permalink","timestamp":1795355207527}],"lastSaveTime":1795355673293}